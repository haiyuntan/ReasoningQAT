diff --git a/awq/utils/calib_data.py b/awq/utils/calib_data.py
index 96514ef..01b4b73 100644
--- a/awq/utils/calib_data.py
+++ b/awq/utils/calib_data.py
@@ -5,0 +6,17 @@ def get_calib_dataset(data="pileval", tokenizer=None, n_samples=512, block_size=
+    if data == 'numinamath_local':
+        import json
+        import os
+        from pathlib import Path
+        source = Path(os.environ['RQ_DATA']) / 'numinamath_128/calib.jsonl'
+        rows = [json.loads(line) for line in source.read_text().splitlines()]
+        assert len(rows) == 128
+        assert 0 < n_samples <= len(rows)
+        samples = []
+        for row in rows[:n_samples]:
+            tokens = tokenizer.encode(row['text'], add_special_tokens=True)[:block_size]
+            if not tokens:
+                raise ValueError('Empty NuminaMath sample')
+            tokens += [tokenizer.eos_token_id] * (block_size-len(tokens))
+            samples.append(torch.tensor([tokens]))
+        print(f'Frozen NuminaMath: {len(samples)} samples, length={block_size}')
+        return samples
